{
  "name": "sb-stocks",
  "version": "1.0.0",
  "description": "Full-stack paper trading platform built with React, Express and MongoDB",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build:client": "npm run build --prefix client",
    "lint:client": "npm run lint --prefix client",
    "typecheck:client": "npm run typecheck --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.21.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "^8.17.0",
    "nodemon": "^3.1.0"
  },
  "private": true
}
